<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="using:ClockworkGit.Controls"
        x:Class="ClockworkGit.Views.MainWindow"
        Title="ClockworkGit" Width="1600" Height="960"
        WindowStartupLocation="CenterScreen"
        Background="#1e1f22" FontSize="12">

  <!-- Shared styles (toolbar buttons, dense lists, diff rows) live in App.axaml. -->
  <Window.Styles>
    <Style Selector="Border.header">
      <Setter Property="Background" Value="#2b2d30" />
      <Setter Property="Padding" Value="6,3" />
      <Setter Property="BorderBrush" Value="#3c3f41" />
      <Setter Property="BorderThickness" Value="0,0,0,1" />
    </Style>
    <Style Selector="TextBlock.header">
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="#c8c8c8" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.colhead">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Padding" Value="2,1" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="CornerRadius" Value="0" />
      <Setter Property="FontSize" Value="11" />
      <Setter Property="Foreground" Value="#9aa0a6" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Left" />
    </Style>
    <Style Selector="TreeViewItem">
      <Setter Property="MinHeight" Value="22" />
      <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
    </Style>
    <Style Selector="CheckBox.small, RadioButton.small">
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="MinWidth" Value="0" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Margin" Value="0,0,2,0" />
    </Style>
    <Style Selector="Button.small">
      <Setter Property="FontSize" Value="11" />
      <Setter Property="Padding" Value="6,0" />
      <Setter Property="MinHeight" Value="0" />
    </Style>
    <Style Selector="GridSplitter">
      <Setter Property="Background" Value="#141517" />
    </Style>
  </Window.Styles>

  <DockPanel>
    <Menu DockPanel.Dock="Top" Background="#2b2d30">
      <MenuItem Header="_Repository">
        <MenuItem Header="_Add Repository…" Click="OnAddRepo" />
        <MenuItem Header="_Refresh" InputGesture="F5" Click="OnRefresh" />
        <MenuItem Header="Open in _Explorer" Click="OnOpenExplorer" />
        <MenuItem Header="Git _LFS…" Click="OnOpenLfs" />
        <Separator />
        <MenuItem Header="Fetch _all repositories now" Click="OnFetchAllRepos" />
        <MenuItem x:Name="AutoFetchMenu" Header="Auto-_fetch">
          <MenuItem Header="Off" ToggleType="Radio" GroupName="autofetch" Tag="0" Click="OnAutoFetchInterval" />
          <MenuItem Header="Every 5 minutes" ToggleType="Radio" GroupName="autofetch" Tag="5" Click="OnAutoFetchInterval" />
          <MenuItem Header="Every 10 minutes" ToggleType="Radio" GroupName="autofetch" Tag="10" Click="OnAutoFetchInterval" />
          <MenuItem Header="Every 30 minutes" ToggleType="Radio" GroupName="autofetch" Tag="30" Click="OnAutoFetchInterval" />
        </MenuItem>
        <Separator />
        <MenuItem Header="E_xit" Click="OnExit" />
      </MenuItem>
      <MenuItem Header="_Local">
        <MenuItem Header="_Commit…" InputGesture="Ctrl+K" Click="OnCommit" />
        <MenuItem Header="_Undo Last Commit" Click="OnUndoCommit" />
        <Separator />
        <MenuItem Header="_Stage" Click="OnStage" />
        <MenuItem Header="U_nstage" Click="OnUnstage" />
        <MenuItem Header="_Discard…" Click="OnDiscard" />
        <Separator />
        <MenuItem Header="Save S_tash…" Click="OnSaveStash" />
        <MenuItem Header="_Apply Stash" Click="OnApplyStash" />
      </MenuItem>
      <MenuItem Header="R_emote">
        <MenuItem Header="_Pull" Click="OnPull" />
        <MenuItem Header="_Sync (pull + push)" Click="OnSync" />
        <MenuItem Header="P_ush" Click="OnPush" />
        <MenuItem Header="_Fetch all" Click="OnFetch" />
      </MenuItem>
    </Menu>

    <Border DockPanel.Dock="Top" Background="#2b2d30" BorderBrush="#3c3f41" BorderThickness="0,0,0,1">
      <Grid x:Name="Toolbar" ColumnDefinitions="Auto,*,Auto,*,Auto" Margin="2">
        <StackPanel Orientation="Horizontal">
          <Button Classes="tool" Click="OnPull" ToolTip.Tip="git pull">
            <StackPanel><TextBlock Classes="glyph" Text="&#xE896;" Foreground="#5fbf5f" /><TextBlock Classes="label" Text="Pull" /></StackPanel>
          </Button>
          <Button Classes="tool" Click="OnSync" ToolTip.Tip="pull, then push">
            <StackPanel><TextBlock Classes="glyph" Text="&#xE895;" Foreground="#e0c050" /><TextBlock Classes="label" Text="Sync" /></StackPanel>
          </Button>
          <Button Classes="tool" Click="OnPush" ToolTip.Tip="git push">
            <StackPanel><TextBlock Classes="glyph" Text="&#xE898;" Foreground="#f0a030" /><TextBlock Classes="label" Text="Push" /></StackPanel>
          </Button>
          <Button Classes="tool" Click="OnFetch" ToolTip.Tip="git fetch --all --prune">
            <StackPanel><TextBlock Classes="glyph" Text="&#xE753;" /><TextBlock Classes="label" Text="Fetch" /></StackPanel>
          </Button>
        </StackPanel>

        <StackPanel Grid.Column="2" Orientation="Horizontal">
          <Button Classes="tool" Click="OnCommit" ToolTip.Tip="Ctrl+K">
            <StackPanel><TextBlock Classes="glyph" Text="&#xE8FB;" Foreground="#5fbf5f" /><TextBlock Classes="label" Text="Commit" /></StackPanel>
          </Button>
          <Button Classes="tool" Click="OnUndoCommit" ToolTip.Tip="git reset --soft HEAD~1">
            <StackPanel><TextBlock Classes="glyph" Text="&#xE7A7;" /><TextBlock Classes="label" Text="Undo Commit" /></StackPanel>
          </Button>
          <Border Width="1" Background="#3c3f41" Margin="6,4" />
          <Button Classes="tool" Click="OnStage">
            <StackPanel><TextBlock Classes="glyph" Text="&#xE710;" /><TextBlock Classes="label" Text="Stage" /></StackPanel>
          </Button>
          <Button Classes="tool" Click="OnUnstage">
            <StackPanel><TextBlock Classes="glyph" Text="&#xE738;" /><TextBlock Classes="label" Text="Unstage" /></StackPanel>
          </Button>
          <Button Classes="tool" Click="OnDiscard">
            <StackPanel><TextBlock Classes="glyph" Text="&#xE74D;" Foreground="#e06060" /><TextBlock Classes="label" Text="Discard" /></StackPanel>
          </Button>
          <Border Width="1" Background="#3c3f41" Margin="6,4" />
          <Button Classes="tool" Click="OnSaveStash">
            <StackPanel><TextBlock Classes="glyph" Text="&#xE74E;" /><TextBlock Classes="label" Text="Save Stash" /></StackPanel>
          </Button>
          <Button Classes="tool" Click="OnApplyStash">
            <StackPanel><TextBlock Classes="glyph" Text="&#xE77F;" /><TextBlock Classes="label" Text="Apply Stash" /></StackPanel>
          </Button>
        </StackPanel>

        <StackPanel Grid.Column="4" Orientation="Horizontal">
          <Button Classes="tool" Click="OnOpenLfs" ToolTip.Tip="Git LFS: files, rules, maintenance">
            <StackPanel><TextBlock Classes="glyph" Text="&#xE7B8;" Foreground="#a990ff" /><TextBlock Classes="label" Text="LFS" /></StackPanel>
          </Button>
          <Button Classes="tool" Click="OnAddRepo">
            <StackPanel><TextBlock Classes="glyph" Text="&#xE8F4;" /><TextBlock Classes="label" Text="Add Repo" /></StackPanel>
          </Button>
          <Button Classes="tool" Click="OnRefresh" ToolTip.Tip="F5">
            <StackPanel><TextBlock Classes="glyph" Text="&#xE72C;" /><TextBlock Classes="label" Text="Refresh" /></StackPanel>
          </Button>
        </StackPanel>
      </Grid>
    </Border>

    <Border x:Name="StateBanner" DockPanel.Dock="Top" IsVisible="False" Background="#5a4712" Padding="8,4">
      <DockPanel>
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="6">
          <Button Content="Resolve…" Click="OnResolveConflicts" ToolTip.Tip="Open the conflict editor for the first conflicted file" />
          <Button Content="Continue" Click="OnStateContinue" />
          <Button Content="Abort" Click="OnStateAbort" />
        </StackPanel>
        <TextBlock x:Name="StateText" VerticalAlignment="Center" FontWeight="SemiBold" />
      </DockPanel>
    </Border>

    <Border DockPanel.Dock="Bottom" Background="#2b2d30" BorderBrush="#3c3f41" BorderThickness="0,1,0,0" Padding="6,2">
      <DockPanel>
        <TextBlock x:Name="StatusRight" DockPanel.Dock="Right" Foreground="#a0a0a0" />
        <TextBlock x:Name="StatusText" Text="Ready" TextTrimming="CharacterEllipsis" />
      </DockPanel>
    </Border>

    <Grid ColumnDefinitions="270,4,*,4,440" RowDefinitions="*,4,330">

      <!-- Left: repositories + branches -->
      <Grid Grid.RowSpan="3" RowDefinitions="Auto,*,4,Auto,2*">
        <Border Classes="header"><TextBlock Classes="header" Text="Repositories" /></Border>
        <ListBox x:Name="ReposList" Grid.Row="1" Classes="dense">
          <ListBox.ItemTemplate>
            <DataTemplate>
              <DockPanel Height="22" ToolTip.Tip="{Binding Tip}">
                <TextBlock DockPanel.Dock="Left" Text="&#xE8B7;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" VerticalAlignment="Center" Foreground="#c8a060" Margin="0,0,6,0" />
                <TextBlock DockPanel.Dock="Right" Text="{Binding Badges}" Foreground="{Binding BadgeBrush}" FontSize="11" VerticalAlignment="Center" Margin="6,0,2,0" />
                <TextBlock Text="{Binding Display}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
              </DockPanel>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
        <GridSplitter Grid.Row="2" ResizeDirection="Rows" />
        <Border Grid.Row="3" Classes="header"><TextBlock Classes="header" Text="Branches" /></Border>
        <TreeView x:Name="BranchTree" Grid.Row="4" Background="#1e1f22">
          <TreeView.ItemTemplate>
            <TreeDataTemplate ItemsSource="{Binding Children}">
              <StackPanel Orientation="Horizontal" Spacing="4">
                <CheckBox Classes="small" IsChecked="{Binding IsChecked}" IsVisible="{Binding CanCheck}" ToolTip.Tip="Show in graph" />
                <TextBlock Text="{Binding Title}" FontWeight="{Binding Weight}" VerticalAlignment="Center" />
                <TextBlock Text="{Binding Detail}" Foreground="#8a8f98" VerticalAlignment="Center" />
              </StackPanel>
            </TreeDataTemplate>
          </TreeView.ItemTemplate>
        </TreeView>
      </Grid>
      <GridSplitter Grid.Column="1" Grid.RowSpan="3" ResizeDirection="Columns" />

      <!-- Center: graph -->
      <DockPanel Grid.Column="2">
        <Border DockPanel.Dock="Top" Classes="header">
          <DockPanel>
            <TextBox x:Name="FilterBox" DockPanel.Dock="Right" Width="240" Watermark="Filter (message, author, hash)" MinHeight="22" Padding="6,2" />
            <TextBlock Classes="header" Text="Graph" />
          </DockPanel>
        </Border>
        <ListBox x:Name="GraphList" Classes="dense" SelectionMode="Multiple"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
          <ListBox.ItemTemplate>
            <DataTemplate>
              <Grid ColumnDefinitions="Auto,*,26,118" Height="22">
                <ui:GraphCell Row="{Binding ShownGraph}" />
                <DockPanel Grid.Column="1" ClipToBounds="True">
                  <ItemsControl DockPanel.Dock="Left" ItemsSource="{Binding Refs}" IsVisible="{Binding HasRefs}" Margin="0,0,6,0" VerticalAlignment="Center">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="3" /></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <Border Background="{Binding Background}" CornerRadius="3" Padding="5,0" Height="16">
                          <TextBlock Text="{Binding Name}" FontSize="11" Foreground="White" VerticalAlignment="Center" />
                        </Border>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                  <TextBlock Text="{Binding Subject}" FontWeight="{Binding SubjectWeight}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                </DockPanel>
                <Border Grid.Column="2" Width="18" Height="16" CornerRadius="2" Background="{Binding AvatarBrush}" IsVisible="{Binding HasAvatar}" ToolTip.Tip="{Binding Author}">
                  <TextBlock Text="{Binding Initials}" FontSize="9" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <TextBlock Grid.Column="3" Text="{Binding DateText}" Foreground="#9aa0a6" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,4,0" />
              </Grid>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </DockPanel>
      <GridSplitter Grid.Column="3" ResizeDirection="Columns" />

      <!-- Right: commit details + files -->
      <Grid Grid.Column="4" RowDefinitions="Auto,Auto,4,Auto,Auto,*">
        <Border Classes="header"><TextBlock Classes="header" Text="Commit" /></Border>
        <ScrollViewer Grid.Row="1" MaxHeight="260">
          <DockPanel Margin="8,6">
            <Border x:Name="DetailAvatar" DockPanel.Dock="Left" Width="44" Height="44" CornerRadius="3" Margin="0,0,10,0" VerticalAlignment="Top" IsVisible="False">
              <TextBlock x:Name="DetailAvatarText" FontSize="20" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <StackPanel Spacing="6">
              <SelectableTextBlock x:Name="DetailHeader" Foreground="#a8adb4" TextWrapping="Wrap" />
              <SelectableTextBlock x:Name="DetailMessage" FontWeight="SemiBold" TextWrapping="Wrap" />
            </StackPanel>
          </DockPanel>
        </ScrollViewer>
        <GridSplitter Grid.Row="2" ResizeDirection="Rows" />
        <Border Grid.Row="3" Classes="header">
          <DockPanel>
            <CheckBox x:Name="LfsOnly" DockPanel.Dock="Right" Classes="small" Content="LFS only" FontSize="11" ToolTip.Tip="Show only files stored in Git LFS" />
            <TextBlock Classes="header" Text="Files" />
          </DockPanel>
        </Border>
        <Grid Grid.Row="4" ColumnDefinitions="18,2*,84,3*" Margin="4,0" Background="#232427">
          <Button x:Name="SortByName" Grid.Column="1" Classes="colhead" Tag="Name" Click="OnSortFiles" ToolTip.Tip="Sort by file name" />
          <TextBlock Grid.Column="2" Text="State" FontSize="11" Foreground="#9aa0a6" VerticalAlignment="Center" Margin="2,0" />
          <Button x:Name="SortByPath" Grid.Column="3" Classes="colhead" Tag="Path" Click="OnSortFiles" ToolTip.Tip="Sort by full path" />
        </Grid>
        <ListBox x:Name="FilesList" Grid.Row="5" Classes="dense" SelectionMode="Multiple" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
          <ListBox.ItemTemplate>
            <DataTemplate>
              <Grid ColumnDefinitions="18,2*,84,3*" Height="20" ToolTip.Tip="{Binding RelPath}">
                <TextBlock Text="{Binding StatusLetter}" Foreground="{Binding StatusBrush}" FontWeight="Bold" VerticalAlignment="Center" />
                <DockPanel Grid.Column="1">
                  <Border DockPanel.Dock="Right" IsVisible="{Binding IsLfs}" Background="#5b4a9a" CornerRadius="2" Padding="3,0" Margin="4,0,4,0" VerticalAlignment="Center" ToolTip.Tip="Stored in Git LFS">
                    <TextBlock Text="LFS" FontSize="9" Foreground="White" />
                  </Border>
                  <TextBlock Text="{Binding Name}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                </DockPanel>
                <TextBlock Grid.Column="2" Text="{Binding State}" Foreground="#9aa0a6" VerticalAlignment="Center" />
                <TextBlock Grid.Column="3" Text="{Binding Folder}" Foreground="#7d838a" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
              </Grid>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </Grid>

      <GridSplitter Grid.Row="1" Grid.Column="2" Grid.ColumnSpan="3" ResizeDirection="Rows" />

      <!-- Bottom: diff -->
      <DockPanel Grid.Row="2" Grid.Column="2" Grid.ColumnSpan="3">
        <Border DockPanel.Dock="Top" Classes="header">
          <DockPanel>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="10">
              <!-- Partial staging, working tree only: compare mode + actions on the selected diff rows. -->
              <StackPanel x:Name="StagePanel" Orientation="Horizontal" Spacing="6" IsVisible="False">
                <RadioButton x:Name="ModeUnstaged" Classes="small" GroupName="diffmode" Content="Unstaged" FontSize="11" ToolTip.Tip="Index ↔ working tree: what Stage adds" />
                <RadioButton x:Name="ModeStaged" Classes="small" GroupName="diffmode" Content="Staged" FontSize="11" ToolTip.Tip="HEAD ↔ index: what Commit records" />
                <RadioButton x:Name="ModeAll" Classes="small" GroupName="diffmode" Content="All" FontSize="11" ToolTip.Tip="HEAD ↔ working tree" />
                <Border Width="1" Background="#3c3f41" Margin="2,2" />
                <Button x:Name="BlockButton" Classes="small" Click="OnBlockAction" ToolTip.Tip="Whole change blocks under the selection (Ctrl+B)" />
                <Button x:Name="LinesButton" Classes="small" Click="OnLinesAction" ToolTip.Tip="Only the selected lines (Ctrl+L)" />
                <Button x:Name="DiscardLinesButton" Classes="small" Content="Discard lines…" Click="OnDiscardLines" ToolTip.Tip="Revert the selected lines in the working tree" />
              </StackPanel>
              <CheckBox x:Name="SvgAsText" Classes="small" Content="As text" FontSize="11" IsVisible="False" ToolTip.Tip="Show SVG source diff instead of the picture" />
              <Button x:Name="OpenCompareButton" Classes="small" Content="Open in compare window" IsEnabled="False" Click="OnOpenCompare" ToolTip.Tip="Double-click a file does the same" />
            </StackPanel>
            <TextBlock x:Name="DiffTitle" Classes="header" Text="Changes" TextTrimming="CharacterEllipsis" />
          </DockPanel>
        </Border>
        <Panel>
          <ListBox x:Name="DiffList" Classes="dense diff" SelectionMode="Multiple" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                   ItemTemplate="{StaticResource DiffRowTemplate}" />
          <ui:ImageCompareView x:Name="ImageView" IsVisible="False" />
        </Panel>
      </DockPanel>
    </Grid>
  </DockPanel>
</Window>
