<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="ClockworkGit.Views.InteractiveRebaseWindow"
        Title="Interactive Rebase" Width="1040" Height="660"
        WindowStartupLocation="CenterOwner"
        Background="#1e1f22" FontSize="12">

  <DockPanel Margin="12">
    <StackPanel DockPanel.Dock="Top" Spacing="4" Margin="0,0,0,8">
      <TextBlock x:Name="HeaderText" FontWeight="SemiBold" FontSize="13" TextWrapping="Wrap" />
      <TextBlock Foreground="#9aa0a6" TextWrapping="Wrap"
                 Text="Top is the newest commit, as in the graph. Squash and Fixup meld a commit into the one below it. Alt+↑/↓ moves the selected commit." />
      <Border x:Name="WarningBox" Background="#5a4712" Padding="8,4" CornerRadius="3" IsVisible="False">
        <TextBlock x:Name="WarningText" TextWrapping="Wrap" />
      </Border>
    </StackPanel>

    <DockPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="8">
        <Button x:Name="StartButton" Content="Start rebase" Click="OnStart" MinWidth="110" HorizontalContentAlignment="Center" />
        <Button Content="Cancel" IsCancel="True" Click="OnCancel" MinWidth="80" HorizontalContentAlignment="Center" />
      </StackPanel>
      <StackPanel Orientation="Horizontal" Spacing="6">
        <Button Content="↑ Move up" Click="OnMoveUp" />
        <Button Content="↓ Move down" Click="OnMoveDown" />
        <TextBlock x:Name="SummaryText" VerticalAlignment="Center" Margin="10,0,0,0" TextWrapping="Wrap" />
      </StackPanel>
    </DockPanel>

    <Grid RowDefinitions="*,Auto,140">
      <ListBox x:Name="Items" Classes="dense">
        <ListBox.ItemTemplate>
          <DataTemplate>
            <Grid ColumnDefinitions="118,76,*,230,116" Height="30" Opacity="{Binding Opacity}">
              <ComboBox ItemsSource="{Binding AllActions}" SelectedItem="{Binding Action, Mode=TwoWay}"
                        MinHeight="0" Height="24" FontSize="11" Width="108" VerticalAlignment="Center" />
              <TextBlock Grid.Column="1" Text="{Binding Commit.ShortHash}" FontFamily="Cascadia Mono,Consolas,monospace" FontSize="11"
                         Foreground="#8a8f98" VerticalAlignment="Center" />
              <TextBlock Grid.Column="2" Text="{Binding Subject}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
              <TextBlock Grid.Column="3" Text="{Binding Hint}" Foreground="#e0c050" FontStyle="Italic" VerticalAlignment="Center" Margin="8,0" TextTrimming="CharacterEllipsis" />
              <TextBlock Grid.Column="4" Text="{Binding Commit.DateText}" Foreground="#9aa0a6" HorizontalAlignment="Right" VerticalAlignment="Center" />
            </Grid>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
      <TextBlock Grid.Row="1" Foreground="#9aa0a6" Margin="0,8,0,4"
                 Text="Message of the selected commit (editing it rewords the commit; for squash the messages are joined):" />
      <TextBox Grid.Row="2" x:Name="MessageBox" AcceptsReturn="True" TextWrapping="Wrap"
               FontFamily="Cascadia Mono,Consolas,monospace"
               Text="{Binding #Items.SelectedItem.Message, Mode=TwoWay}"
               IsEnabled="{Binding #Items.SelectedItem, Converter={x:Static ObjectConverters.IsNotNull}}" />
    </Grid>
  </DockPanel>
</Window>
