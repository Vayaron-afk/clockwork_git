<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="ClockworkGit.UI.ImageCompareView">
  <DockPanel>
    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="10" Margin="6,4">
      <RadioButton x:Name="ModeSide" GroupName="imgmode" Content="Side by side" IsChecked="True" />
      <RadioButton x:Name="ModeOnion" GroupName="imgmode" Content="Onion skin" />
      <RadioButton x:Name="ModeDiff" GroupName="imgmode" Content="Difference" />
      <Slider x:Name="OnionSlider" Width="160" Minimum="0" Maximum="1" Value="0.5" IsVisible="False" VerticalAlignment="Center" />
      <ComboBox x:Name="ZoomBox" SelectedIndex="0" MinWidth="80" VerticalAlignment="Center" ToolTip.Tip="Zoom">
        <ComboBoxItem Content="Fit" />
        <ComboBoxItem Content="25%" />
        <ComboBoxItem Content="50%" />
        <ComboBoxItem Content="100%" />
        <ComboBoxItem Content="200%" />
        <ComboBoxItem Content="400%" />
        <ComboBoxItem Content="800%" />
      </ComboBox>
      <TextBlock x:Name="Info" Foreground="#9aa0a6" VerticalAlignment="Center" />
    </StackPanel>
    <Panel>
      <Grid x:Name="SideGrid" ColumnDefinitions="*,6,*" RowDefinitions="Auto,*">
        <TextBlock Text="Old" Foreground="#e06060" Margin="4,0,0,2" />
        <TextBlock Grid.Column="2" Text="New" Foreground="#5fbf5f" Margin="4,0,0,2" />
        <ScrollViewer x:Name="OldScroll" Grid.Row="1">
          <LayoutTransformControl x:Name="OldZoom" HorizontalAlignment="Center" VerticalAlignment="Center">
            <Image x:Name="OldImage" />
          </LayoutTransformControl>
        </ScrollViewer>
        <ScrollViewer x:Name="NewScroll" Grid.Row="1" Grid.Column="2">
          <LayoutTransformControl x:Name="NewZoom" HorizontalAlignment="Center" VerticalAlignment="Center">
            <Image x:Name="NewImage" />
          </LayoutTransformControl>
        </ScrollViewer>
      </Grid>
      <ScrollViewer x:Name="OverlayScroll" IsVisible="False">
        <LayoutTransformControl x:Name="OverlayZoom" HorizontalAlignment="Center" VerticalAlignment="Center">
          <Panel>
            <Image x:Name="OnionOld" />
            <Image x:Name="OnionNew" Opacity="{Binding #OnionSlider.Value}" />
          </Panel>
        </LayoutTransformControl>
      </ScrollViewer>
      <ScrollViewer x:Name="DiffScroll" IsVisible="False" Background="#111">
        <LayoutTransformControl x:Name="DiffZoom" HorizontalAlignment="Center" VerticalAlignment="Center">
          <Image x:Name="DiffImage" />
        </LayoutTransformControl>
      </ScrollViewer>
    </Panel>
  </DockPanel>
</UserControl>
