<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="using:ClockworkGit.Controls"
             xmlns:git="using:ClockworkGit.Models"
             x:Class="ClockworkGit.App"
             RequestedThemeVariant="Dark">
  <Application.Styles>
    <FluentTheme DensityStyle="Compact" />
    <Style Selector="TextBlock.mono">
      <Setter Property="FontFamily" Value="Cascadia Mono,Consolas,monospace" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="TextBlock.lineNo">
      <Setter Property="FontFamily" Value="Cascadia Mono,Consolas,monospace" />
      <Setter Property="FontSize" Value="11" />
      <Setter Property="Foreground" Value="#6f737a" />
      <Setter Property="HorizontalAlignment" Value="Right" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Margin" Value="0,0,6,0" />
    </Style>
    <!-- Toolbar buttons: icon over label, as in SmartGit. -->
    <Style Selector="Button.tool">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Padding" Value="8,3" />
      <Setter Property="MinWidth" Value="58" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.tool StackPanel">
      <Setter Property="Spacing" Value="1" />
    </Style>
    <Style Selector="TextBlock.glyph">
      <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets" />
      <Setter Property="FontSize" Value="18" />
      <Setter Property="HorizontalAlignment" Value="Center" />
    </Style>
    <Style Selector="TextBlock.label">
      <Setter Property="FontSize" Value="11" />
      <Setter Property="HorizontalAlignment" Value="Center" />
    </Style>
    <!-- Compact lists without Fluent's tall rows. -->
    <Style Selector="ListBox.dense">
      <Setter Property="Background" Value="#1e1f22" />
      <Setter Property="Padding" Value="0" />
    </Style>
    <Style Selector="ListBox.dense ListBoxItem">
      <Setter Property="Padding" Value="4,0" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    </Style>
    <!-- Diff rows paint their own backgrounds, so mark selected rows with a strong colour in the gutters. -->
    <Style Selector="ListBox.diff ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#3d6fb4" />
    </Style>
    <Style Selector="ListBox.diff ListBoxItem">
      <Setter Property="Padding" Value="0" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    </Style>
    <!-- Annotation at the right edge of a diff line (Unity GUID → asset name). -->
    <Style Selector="Border.note">
      <Setter Property="HorizontalAlignment" Value="Right" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Background" Value="#E6202833" />
      <Setter Property="BorderBrush" Value="#4a6a90" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="3" />
      <Setter Property="Padding" Value="5,0" />
      <Setter Property="Margin" Value="0,0,3,0" />
    </Style>
    <Style Selector="Border.note TextBlock">
      <Setter Property="FontSize" Value="11" />
      <Setter Property="Foreground" Value="#a9c8ee" />
    </Style>
  </Application.Styles>

  <Application.Resources>
    <!-- One side-by-side diff row; shared by the bottom diff panel and the File Compare window. -->
    <DataTemplate x:Key="DiffRowTemplate" x:DataType="git:DiffRow">
      <Grid ColumnDefinitions="46,*,2,46,*" Height="17">
        <TextBlock Classes="lineNo" Text="{Binding LeftNo}" />
        <Border Grid.Column="1" Background="{Binding LeftBg}" ClipToBounds="True">
          <Panel>
            <ui:DiffText Classes="mono" Margin="4,0" Value="{Binding LeftText}"
                         HiStart="{Binding LeftHiStart}" HiLength="{Binding LeftHiLength}"
                         HiBrush="{x:Static git:DiffRow.RemovedHi}" />
            <Border Classes="note" IsVisible="{Binding LeftNote, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                    ToolTip.Tip="{Binding LeftNoteTip}">
              <TextBlock Text="{Binding LeftNote}" />
            </Border>
          </Panel>
        </Border>
        <Border Grid.Column="2" Background="#3c3f41" />
        <TextBlock Grid.Column="3" Classes="lineNo" Text="{Binding RightNo}" />
        <Border Grid.Column="4" Background="{Binding RightBg}" ClipToBounds="True">
          <Panel>
            <ui:DiffText Classes="mono" Margin="4,0" Value="{Binding RightText}"
                         HiStart="{Binding RightHiStart}" HiLength="{Binding RightHiLength}"
                         HiBrush="{x:Static git:DiffRow.AddedHi}" />
            <Border Classes="note" IsVisible="{Binding RightNote, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                    ToolTip.Tip="{Binding RightNoteTip}">
              <TextBlock Text="{Binding RightNote}" />
            </Border>
          </Panel>
        </Border>
      </Grid>
    </DataTemplate>
  </Application.Resources>
</Application>
